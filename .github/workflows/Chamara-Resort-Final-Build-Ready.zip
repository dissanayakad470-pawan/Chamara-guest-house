name: Build Android APK from ZIP

on:
  workflow_dispatch:
  push:
    branches: [ "main" ]

permissions:
  contents: read

env:
  GRADLE_OPTS: -Dorg.gradle.jvmargs=-Xmx4g -Dfile.encoding=UTF-8
  PROJECT_ZIP: Chamara-Resort-Final-Build-Ready.zip

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Check ZIP exists
        run: |
          test -f "$PROJECT_ZIP" || { echo "ZIP not found: $PROJECT_ZIP"; ls -la; exit 1; }

      - name: Extract Android project from ZIP
        run: |
          rm -rf build-project
          mkdir -p build-project
          unzip -q "$PROJECT_ZIP" -d build-project
          echo "Extracted project:"
          ls -la build-project
          test -f build-project/settings.gradle.kts || { echo "settings.gradle.kts not found at ZIP root"; find build-project -maxdepth 3 -type f | head -80; exit 1; }

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Android SDK
        uses: android-actions/setup-android@v3

      - name: Install Android SDK packages
        run: |
          yes | sdkmanager --licenses >/dev/null || true
          sdkmanager "platform-tools" "platforms;android-36" "platforms;android-36-ext1" "build-tools;36.0.0"

      - name: Set up Gradle 9.3.1
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '9.3.1'

      - name: Build debug APK
        working-directory: build-project
        run: gradle --no-daemon --stacktrace assembleDebug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: Chamara-Resort-debug-apk
          path: build-project/app/build/outputs/apk/debug/*.apk
          if-no-files-found: error
